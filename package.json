{
  "name": "resume-generator",
  "version": "1.0.0",
  "description": "Resume generator with multiple themes",
  "type": "module",
  "bin": {
    "resume-gen": "./bin/resume-gen"
  },
  "scripts": {
    "install:all": "bun install",
    "gen": "bun run src/cli/index.ts generate",
    "list": "bun run src/cli/index.ts list",
    "validate": "bun run src/cli/index.ts validate",
    "switch": "bun run src/cli/index.ts switch",
    "install": "bun run src/cli/index.ts install",
    "prerun": "bun run src/cli/index.ts prerun",
    "clean": "bun run src/cli/index.ts clean",
    "build": "bun build --compile src/cli/index.ts --outfile bin/resume-gen",
    "help": "bun run src/cli/index.ts help"
  },
  "dependencies": {
    "@clack/prompts": "^0.9.1",
    "resume-cli": "^3.0.8",
    "jsonresume-theme-actual": "^0.1.8",
    "jsonresume-theme-apage": "^1.0.2",
    "jsonresume-theme-autumn": "^1.0.1",
    "jsonresume-theme-caffeine": "^1.2.3",
    "jsonresume-theme-class": "^0.1.2",
    "jsonresume-theme-classy": "^1.0.9",
    "jsonresume-theme-cora": "^0.1.1",
    "jsonresume-theme-dave": "^1.0.1",
    "jsonresume-theme-elegant": "^1.16.1",
    "jsonresume-theme-eloquent": "^4.1.0",
    "jsonresume-theme-even": "^0.17.1",
    "jsonresume-theme-flat": "^0.3.7",
    "jsonresume-theme-flat-fr": "0.0.1",
    "jsonresume-theme-full": "0.0.4",
    "jsonresume-theme-github": "0.0.5",
    "jsonresume-theme-jacrys": "^1.0.4",
    "jsonresume-theme-kards": "^1.0.2",
    "jsonresume-theme-keloran": "^1.0.2",
    "jsonresume-theme-kendall": "^0.2.0",
    "jsonresume-theme-macchiato": "^1.1.0",
    "jsonresume-theme-mantra": "^0.2.1",
    "jsonresume-theme-mocha-responsive": "^1.1.1",
    "jsonresume-theme-modern": "0.0.18",
    "jsonresume-theme-msresume": "^0.1.0",
    "jsonresume-theme-onepage": "0.0.3",
    "jsonresume-theme-onepageresume": "0.0.6",
    "jsonresume-theme-orbit": "^1.1.0",
    "jsonresume-theme-paper": "^0.5.0",
    "jsonresume-theme-paper-plus-plus": "^0.5.1",
    "jsonresume-theme-papirus": "0.0.5",
    "jsonresume-theme-pumpkin": "^1.1.4",
    "jsonresume-theme-rocketspacer": "^1.2.2",
    "jsonresume-theme-short": "^0.1.7",
    "jsonresume-theme-simple-red": "^1.0.4",
    "jsonresume-theme-slick": "^0.1.16",
    "jsonresume-theme-spartan": "^0.3.0",
    "jsonresume-theme-srt": "^0.1.3",
    "jsonresume-theme-stackoverflow": "^1.4.0",
    "jsonresume-theme-standard-resume": "^1.3.0",
    "jsonresume-theme-tachyons-clean": "0.0.9",
    "jsonresume-theme-tan-responsive": "0.0.7",
    "jsonresume-theme-techlead": "^1.0.1",
    "jsonresume-theme-verbum": "0.0.5",
    "jsonresume-theme-wraypro": "0.0.5"
  },
  "devDependencies": {
    "@types/bun": "^1.3.6"
  }
}
